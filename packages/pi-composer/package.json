{
  "name": "pi-composer",
  "version": "0.1.0",
  "description": "Composer extension scaffold for Pi.",
  "keywords": [
    "composer",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
